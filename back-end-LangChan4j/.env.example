# 配置说明样例；Spring Boot 不会自动加载本文件，请通过终端/IDE 注入环境变量。
DB_URL=jdbc:postgresql://localhost:5432/luoye
DB_USERNAME=luoye
DB_PASSWORD=
LLM_CHAT_PROVIDER=openai-compatible
LLM_CHAT_BASE_URL=
LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=
LLM_EMBEDDING_PROVIDER=openai-compatible
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIMENSION=1536
OLLAMA_BASE_URL=http://localhost:11434
# 后续 HS256 使用至少 256-bit 随机密钥；当前仅预留配置。
LUOYE_JWT_SECRET=
LUOYE_JWT_EXP_HOURS=1LLM_CHAT_TIMEOUT=60
LLM_CHAT_TEMPERATURE=0.7
LUOYE_AUTH_USERNAME=admin
LUOYE_AUTH_PASSWORD=change-this-password
LUOYE_CHAT_MAX_MESSAGES=20
LUOYE_CHAT_TIMEOUT_SECONDS=120
LUOYE_CHAT_PERSONA=你是落叶，一位温暖、诚实、有独立判断的个人助手。用中文简洁回答，记不清时坦诚说明。